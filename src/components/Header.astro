---
import Logo from './Logo.astro';
import { navigation, praxis } from '../data/praxis';

const pfad = Astro.url.pathname;
const aktiv = (href: string) => pfad.startsWith(href);
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo">
      <Logo />
      <span class="visually-hidden">, zur Startseite</span>
    </a>

    <nav aria-label="Hauptnavigation" class="header__nav">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} aria-current={aktiv(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={praxis.telefonHref} class="header__telefon" aria-label={`Anrufen: ${praxis.telefon}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"
          fill="currentColor"></path></svg
      >
      <span>{praxis.telefon}</span>
    </a>
    <a href="/kontakt/" class="btn btn--voll header__cta">Termin anfragen</a>

    <button class="header__toggle" popovertarget="menu" aria-label="Menü öffnen">
      <span></span><span></span>
    </button>
  </div>

  <div id="menu" popover class="menu">
    <div class="menu__head container">
      <Logo />
      <button popovertarget="menu" popovertargetaction="hide" class="menu__close" aria-label="Menü schließen">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <nav aria-label="Mobile Navigation" class="container">
      <ul>
        <li><a href="/" aria-current={pfad === '/' ? 'page' : undefined}>Start</a></li>
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} aria-current={aktiv(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="menu__kontakt">
        <a href={praxis.telefonHref} class="btn btn--rand">{praxis.telefon}</a>
        <a href="/kontakt/" class="btn btn--voll">Termin anfragen</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--sand) 88%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    min-height: 4.75rem;
  }
  .header__logo {
    text-decoration: none;
    margin-right: auto;
  }
  .header__nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__nav a {
    display: block;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    transition: background-color 0.2s var(--ease);
  }
  .header__nav a:hover {
    background: var(--salbei-hell);
  }
  .header__nav a[aria-current='page'] {
    background: var(--salbei-hell);
    color: var(--salbei-2);
    font-weight: 600;
  }
  .header__telefon {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .header__telefon svg {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--salbei);
  }
  .header__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: var(--salbei-hell);
    color: var(--salbei-3);
    cursor: pointer;
    position: relative;
  }
  .header__toggle span {
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }
  .header__toggle span:nth-child(1) {
    top: 1.05rem;
  }
  .header__toggle span:nth-child(2) {
    top: 1.55rem;
  }

  .menu {
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    padding: 0;
    background: var(--sand);
    color: var(--ink);
    opacity: 0;
    transition:
      opacity 0.25s var(--ease),
      display 0.25s allow-discrete,
      overlay 0.25s allow-discrete;
  }
  .menu:popover-open {
    opacity: 1;
  }
  @starting-style {
    .menu:popover-open {
      opacity: 0;
    }
  }
  .menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.75rem;
    border-bottom: 1px solid var(--line);
  }
  .menu__close {
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: var(--salbei-hell);
    color: inherit;
    cursor: pointer;
    padding: 0.65rem;
  }
  .menu ul {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }
  .menu li a {
    display: block;
    padding-block: 0.7rem;
    font-family: var(--font-display-stack);
    font-size: 2rem;
    line-height: 1.2;
    text-decoration: none;
  }
  .menu li a[aria-current='page'] {
    color: var(--salbei);
  }
  .menu__kontakt {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (max-width: 72rem) {
    .header__telefon span {
      display: none;
    }
  }
  @media (max-width: 60rem) {
    .header__nav,
    .header__cta {
      display: none;
    }
    .header__toggle {
      display: block;
    }
    .header__telefon {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 50%;
      border: 1px solid var(--salbei-mittel);
    }
  }
</style>
