---
import Arrow from './Arrow.astro';
import { praxis } from '../data/praxis';

interface Props {
  titel?: string;
}
const { titel = 'Bereit für den ersten Termin?' } = Astro.props;
---

<section class="container cta-wrap">
  <div class="cta dunkel">
    <div class="cta__text">
      <span class="cta__marke nur-trainingsplan" aria-hidden="true">Nächster Schritt</span>
      <h2 class="h2">{titel}</h2>
      <p>
        Rufen Sie uns an oder schreiben Sie uns. Wir melden uns innerhalb eines Werktags mit einem Terminvorschlag, meist schon für die
        laufende Woche.
      </p>
    </div>
    <div class="cta__aktionen">
      <a href="/kontakt/" class="btn btn--voll">Termin anfragen <Arrow /></a>
      <a href={praxis.telefonHref} class="btn btn--rand">{praxis.telefon}</a>
      <p class="cta__zeiten">Telefonisch erreichbar {praxis.telefonzeiten}</p>
    </div>
  </div>
</section>

<style>
  /* Ruhepuls: mittig, mit einem großen, ruhigen Bogen als Hintergrund */
  .cta-wrap {
    padding-bottom: var(--section);
  }
  .cta {
    position: relative;
    overflow: hidden;
    display: grid;
    justify-items: center;
    gap: 2rem;
    padding: clamp(2.5rem, 1rem + 5vw, 5.5rem) clamp(1.5rem, 1rem + 3vw, 4rem);
    border-radius: var(--radius-gross);
    text-align: center;
  }
  .cta::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 62%;
    width: 120%;
    aspect-ratio: 1;
    translate: -50% 0;
    border: 1px solid #3c5e52;
    border-radius: 50%;
    box-shadow:
      0 0 0 3rem var(--salbei-3),
      0 0 0 calc(3rem + 1px) #34544a;
    pointer-events: none;
  }
  .cta > * {
    position: relative;
  }
  .cta__text {
    display: grid;
    gap: 1rem;
    justify-items: center;
  }
  .cta__text p {
    color: var(--on-salbei-2);
    max-width: 34em;
  }
  .cta__aktionen {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  .cta__zeiten {
    flex-basis: 100%;
    font-size: 0.9rem;
    color: var(--on-salbei-2);
  }
</style>
