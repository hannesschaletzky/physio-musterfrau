---
// Ruhiger Seitenkopf: Überschrift mittig, optional ein breites Foto darunter
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { navigation } from '../data/praxis';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  bild?: ImageMetadata;
  alt?: string;
  abb?: string;
}
const { eyebrow, title, lead, bild, alt = '', abb } = Astro.props;

// „Abb. 2.1 Text“: die Nummer wird wie bei den anderen Abbildungen abgesetzt
const [abbNr, abbText] = abb ? [abb.split(' ').slice(0, 2).join(' '), abb.split(' ').slice(2).join(' ')] : [];

// Kapitelnummer aus der Position im Menü (Lehrbuch: „Kapitel 2“, Trainingsplan: „02“)
const kapitel = navigation.findIndex((n) => Astro.url.pathname.startsWith(n.href)) + 1;
---

<section class="intro">
  <div class:list={['container', 'intro__inner', { 'intro__inner--bild': bild }]}>
    <div class="intro__text">
      {
        kapitel > 0 && (
          <span class="intro__kapitel" aria-hidden="true">
            <span class="nur-lehrbuch">Kapitel {kapitel}</span>
            <span class="nur-trainingsplan">{String(kapitel).padStart(2, '0')}</span>
          </span>
        )
      }
      <span class="eyebrow">{eyebrow}</span>
      <h1 class="display" set:html={title} />
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {
      bild && (
        <figure class="intro__bild">
          <div class="img-frame">
            <Picture src={bild} alt={alt} widths={[480, 720, 960, 1280]} sizes="(min-width: 60rem) 70vw, 92vw" formats={['avif', 'webp']} loading="eager" />
          </div>
          {abb && (
            <figcaption class="abb nur-lehrbuch" aria-hidden="true">
              <span>{abbNr}</span> {abbText}
            </figcaption>
          )}
        </figure>
      )
    }
  </div>
</section>

<style>
  .intro__inner {
    padding-top: clamp(3rem, 2rem + 5vw, 6rem);
    padding-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    justify-items: center;
    text-align: center;
  }
  .intro__text {
    display: grid;
    gap: 1.4rem;
    justify-items: center;
  }
  .intro__kapitel {
    display: none;
  }
  h1 {
    max-width: 18ch;
  }
  .lead {
    margin-inline: auto;
  }
  .intro__bild {
    margin: 0;
    width: 100%;
    max-width: 60rem;
  }
  .intro__bild .img-frame {
    aspect-ratio: 21 / 9;
    border-radius: 999px;
  }
  @media (max-width: 40rem) {
    .intro__bild .img-frame {
      aspect-ratio: 4 / 3;
      border-radius: var(--radius-gross);
    }
  }
</style>
