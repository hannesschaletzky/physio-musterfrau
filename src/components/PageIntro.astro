---
// Ruhiger Seitenkopf: Überschrift links, optional ein Foto rechts
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  bild?: ImageMetadata;
  alt?: string;
}
const { eyebrow, title, lead, bild, alt = '' } = Astro.props;
---

<section class="intro">
  <div class:list={['container', 'intro__inner', { 'intro__inner--bild': bild }]}>
    <div class="intro__text">
      <span class="eyebrow">{eyebrow}</span>
      <h1 class="display" set:html={title} />
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {
      bild && (
        <div class="img-frame intro__bild">
          <Picture src={bild} alt={alt} widths={[480, 720, 960]} sizes="(min-width: 60rem) 40vw, 92vw" formats={['avif', 'webp']} loading="eager" />
        </div>
      )
    }
  </div>
</section>

<style>
  .intro__inner {
    padding-top: clamp(3rem, 2rem + 5vw, 6rem);
    padding-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .intro__inner--bild {
    grid-template-columns: 1.15fr 1fr;
  }
  .intro__text {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  h1 {
    max-width: 16ch;
  }
  .intro__bild {
    aspect-ratio: 5 / 4;
    border-radius: var(--radius-gross);
  }
  @media (max-width: 60rem) {
    .intro__inner--bild {
      grid-template-columns: 1fr;
    }
  }
</style>
