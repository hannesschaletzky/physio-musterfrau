---
import '../styles/global.css';
import { createHash } from 'node:crypto';
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import DemoBar from '../components/DemoBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { praxis } from '../data/praxis';
import standardBild from '../assets/images/behandlungsraum.jpg';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  jsonLd?: Record<string, unknown>;
}

const { title, description, image = standardBild, jsonLd } = Astro.props;

const seitenTitel = Astro.url.pathname === '/' ? `${praxis.name} in ${praxis.ort} · ${praxis.claim}` : `${title} · ${praxis.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site);
const standardOg = await getImage({ src: standardBild, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });

// Wochentage für die Öffnungszeiten in schema.org
const oeffnung = [
  { dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'], opens: '07:30', closes: '19:00' },
  { dayOfWeek: 'Friday', opens: '07:30', closes: '14:00' },
].map((o) => ({ '@type': 'OpeningHoursSpecification', ...o }));

const betrieb = {
  '@context': 'https://schema.org',
  '@type': 'Physiotherapy',
  '@id': `${Astro.site}#praxis`,
  name: praxis.name,
  founder: { '@type': 'Person', name: praxis.inhaberin },
  url: Astro.site?.toString(),
  telephone: praxis.telefon,
  email: praxis.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: praxis.strasse,
    postalCode: praxis.plz,
    addressLocality: praxis.ort,
    addressCountry: 'DE',
  },
  openingHoursSpecification: oeffnung,
  image: new URL(standardOg.src, Astro.site).toString(),
  logo: new URL('/favicon.svg', Astro.site).toString(),
};

// JSON-LD wird nicht ausgeführt, Validatoren werten es aber als Inline-Skript: Hash in die CSP aufnehmen.
const strukturiert = [betrieb, jsonLd].filter(Boolean).map((d) => JSON.stringify(d));
for (const json of strukturiert) {
  Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(json).digest('base64')}`);
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitenTitel}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f6f4ef" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={praxis.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />

    {strukturiert.map((json) => <script type="application/ld+json" set:html={json} />)}
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <DemoBar />
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
  </body>
</html>
